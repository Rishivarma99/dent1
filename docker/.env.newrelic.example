# Copy this file to docker/.env.newrelic and fill in real values.
# The real .env.newrelic is gitignored — never commit secrets.

# .NET APM (backend) — license key is SECRET.
NEW_RELIC_LICENSE_KEY=replace-me
NEW_RELIC_APP_NAME=Dent1.Api

# Optional: regional collector. Leave blank for US, set to "eu01.nr-data.net" etc. for EU.
# NEW_RELIC_HOST=
