# Project-wide DEV defaults (tracked in Git, non-secret).
# For secrets and per-developer overrides, see docker/.env.newrelic and similar gitignored files.
#
# All values here are loaded into containers via `env_file: ../.env` in docker-compose.yml.
# Keys use the exact names each runtime expects, so no `${...}` substitution is needed.

# ---- SQL Server (host machine — same instance as appsettings.Development.json) ----
# Docker API reaches Windows SQL via host.docker.internal. SQL auth is required from the
# Linux container (Integrated Security does not apply). Set User Id/Password to a login
# your SQLEXPRESS instance accepts, or enable mixed mode and use sa.
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=CHANGEME

# ---- API runtime mode ----
API_HOST_PORT=5003
API_BUILD_TARGET=development
ASPNETCORE_ENVIRONMENT=Development

# ---- ASP.NET config (double-underscore = nested config section) ----
# DefaultConnection for Docker is set in docker/docker-compose.yml (host SQL via host.docker.internal).
Jwt__Issuer=Dent1.Api
Jwt__Audience=Dent1.Client
Jwt__Key=Dent1_Super_Secret_Key_Replace_For_Prod_At_Least_32_Chars

# ---- Frontend ----
FRONTEND_HOST_PORT=4201
FRONTEND_BUILD_TARGET=production
FRONTEND_CONTAINER_PORT=80
